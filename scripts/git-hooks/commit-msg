# --- Reviewer 판정의 검토 범위(scope) 강제 여부 -----------------------------
# 1 = 필수. Reviewer 는 `최종 판정: PASS (scope: src/lib/safety/, ...)` 처럼 자신이 실제로
#     검토한 경로를 밝혀야 하고, staged 된 안전파일이 그 범위 밖이면 커밋이 차단된다.
#     이것이 REV-025 CRITICAL("차용된 정당성" — 무관한 과거 task ID 를 인용해 아무 안전코드나
#     통과시키는 우회)을 실제로 막는 유일한 장치다.
# 0 = scope 없으면 경고만 하고 통과(= CRITICAL 재발). 운영 마찰이 과도할 때 Leader 판단으로만
#     내릴 것. 안전장치의 기본값은 fail-closed 여야 하므로 1 을 기본으로 둔다.
REQUIRE_SCOPE=1

# --- staged 파일 목록 ------------------------------------------------------
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  STAGED="$(git diff --cached --name-only --no-renames)"
else
  EMPTY_TREE="$(git hash-object -t tree /dev/null)"
  STAGED="$(git diff --cached --name-only --no-renames "$EMPTY_TREE")"
fi
if [ $? -ne 0 ]; then
  say "❌ [commit-msg] staged 파일 목록을 읽지 못했습니다 (안전상 커밋을 차단합니다)."
  exit 1
fi

[ -z "$STAGED" ] && exit 0

# 패턴들을 하나의 ERE 로 결합
SAFETY_RE=""
for p in "${SAFETY_PATHS[@]}"; do
  if [ -z "$SAFETY_RE" ]; then SAFETY_RE="$p"; else SAFETY_RE="$SAFETY_RE|$p"; fi
done

MATCHED="$(printf '%s\n' "$STAGED" | grep -E "$SAFETY_RE")"

# 안전 관련 파일이 없으면 통과 — 문서/UI/vault 전용 커밋을 막지 않는다
[ -z "$MATCHED" ] && exit 0

# --- 커밋 메시지 본문 (주석·verbose diff 제거) ------------------------------
COMMENT_CHAR="$(git config --get core.commentChar 2>/dev/null || true)"
[ -z "$COMMENT_CHAR" ] && COMMENT_CHAR='#'
[ "$COMMENT_CHAR" = "auto" ] && COMMENT_CHAR='#'

msg_body() {
  # 1) `# ------ >8 ------` scissors 이후(= commit -v 의 raw diff)는 전부 버린다
  #    → diff 안에 우연히 들어 있는 T-NNN 문자열로 검사가 통과되는 fail-open 방지
  # 2) 주석(#) 줄도 버린다 → 템플릿/안내문의 T-NNN 도 인정하지 않는다
  awk -v cc="$COMMENT_CHAR" '
    substr($0, 1, 1) == cc && index($0, ">8") > 0 { exit }
    substr($0, 1, 1) == cc { next }
    { print }
  ' "$MSG_FILE"
}

# --- task ID 추출 ----------------------------------------------------------
# 토큰 단위로 잘라(영숫자와 '-' 만 남김) 앞이 잘린 오탐(refT-020)과
# 자릿수 초과(T-0255 → T-025 로 오인)를 모두 배제한다.
TASK_IDS="$(msg_body \
  | tr -c 'A-Za-z0-9-' '\n' \
  | grep -oE '^[Tt]-[0-9]{3}([^0-9]|$)' \
  | grep -oE '^[Tt]-[0-9]{3}' \
  | tr '[:lower:]' '[:upper:]' \
  | sort -u)"

print_header() {
  say ""
  say "🛑 커밋 차단 — 안전 관련 코드 변경에는 Reviewer 독립감사 기록이 필요합니다."
  say ""
  say "   staged 된 안전 관련 파일:"
  printf '%s\n' "$MATCHED" | while IFS= read -r f; do [ -n "$f" ] && say "     - $f"; done
  say ""
}

print_footer() {
  say ""
  say "   해결 방법:"
  say "     1) Reviewer 에이전트에게 **지금 staged 된 이 파일들에 대한** 독립감사를 요청한다"
  say "        (과거의 무관한 task 판정을 끌어다 쓰는 것은 우회이며 금지된다)"
  say "     2) Reviewer 가 $TASKS_DIR/T-NNN-*.md 의 '## Reviewer' 섹션 마지막에"
  say "        아래 형식으로 판정을 기록한다 — 마지막 '최종 판정' 줄 하나만 유효하다:"
  say "          최종 판정: PASS (scope: src/lib/safety/, src/app/api/orders/)"
  say "        · 판정은 PASS / CONDITIONAL_PASS / FAIL 중 리터럴 대문자"
  say "        · scope 는 실제로 검토한 경로들. staged 안전파일이 전부 이 범위 안이어야 통과"
  say "     3) 커밋 메시지에 해당 task ID(예: T-025)를 포함해 다시 커밋한다"
  say ""
  say "   ⚠ 오탐이라고 판단되면 사용자(사람)만 아래로 우회할 수 있습니다:"
  say "        git commit --no-verify"
  say "      (에이전트가 임의로 --no-verify 를 쓰는 것은 금지 — 이 훅의 존재 이유입니다)"
  say ""
}

if [ -z "$TASK_IDS" ]; then
  print_header
  say "   ✗ 커밋 메시지에 task ID(T-NNN)가 없습니다."
  say "     안전 관련 파일이 포함된 커밋은 어떤 task 의 산출물인지 반드시 밝혀야 합니다."
  print_footer
  exit 1
fi

# --- task 별 Reviewer 판정 확인 --------------------------------------------
reviewer_body() {
  # '##' 이상 헤딩 중 제목에 reviewer 가 들어간 섹션의 본문만 출력
  # (다음 헤딩을 만나면 종료 → QA 섹션의 "Reviewer PASS" 언급은 인정하지 않는다)
  awk '
    /^##+[ \t]/ { in_rev = (tolower($0) ~ /reviewer/) ? 1 : 0; next }
    in_rev { print }
  ' "$1"
}

# --- 판정 해석 (H3: 마지막 "최종 판정" 줄 하나만 권위 있는 판정) -------------
#
# 이전 구현은 Reviewer 섹션 어딘가에 `PASS` 문자열이 있기만 하면 통과시켰다.
# 그 결과 ① 라운드1 PASS 뒤에 라운드2 FAIL 이 와도 통과 ② 결함을 *설명하는* 산문이
# 판정 단어를 인용하기만 해도 통과 — 라는 fail-open 이 있었다(REV-025 H3).
# 이제는 "최종 판정" 이 들어간 줄만 판정으로 인정하고, 그중 **마지막 줄**을 채택한다.
#
# 인정 포맷(마크다운 장식·타임스탬프 접두는 허용):
#   최종 판정: PASS (scope: src/lib/exchanges/, src/app/api/orders/)
#   - [10:40] **최종 판정: CONDITIONAL_PASS (scope: src/lib/safety/)**
#   **정정된 최종 판정: FAIL**
verdict_line() {
  # 마지막 "최종 판정" 줄 (없으면 빈 문자열)
  printf '%s\n' "$1" | grep -E '최종[[:space:]]*판정' | tail -1
}

verdict_of() {
  # 줄에서 첫 판정 토큰을 뽑는다. grep -E 는 leftmost-longest 이므로
  # CONDITIONAL_PASS 안의 PASS 가 아니라 CONDITIONAL_PASS 전체가 잡힌다.
  printf '%s\n' "$1" | grep -oE '(^|[^A-Za-z])(CONDITIONAL_PASS|PASS|FAIL)([^A-Za-z]|$)' \
    | grep -oE '(CONDITIONAL_PASS|PASS|FAIL)' | head -1
}

scope_of() {
  # `(scope: a/, b/)` → "a/ b/"  (없으면 빈 문자열)
  printf '%s\n' "$1" \
    | grep -oE 'scope:[[:space:]]*[^)]*' | head -1 \
    | sed 's/^scope:[[:space:]]*//' \
    | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'
}

# staged 안전파일이 전부 scope 접두어 안에 들어가는지 — 아니면 목록 반환
files_out_of_scope() {
  local scope="$1" f s ok
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    ok=0
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      # 경계 있는 매칭 (REV-025 라운드4 HIGH):
      #   `src/lib/safety/` 처럼 '/' 로 끝나면 → 디렉토리 접두어 매칭
      #   `src/lib/auth/session.ts` 처럼 아니면 → 정확히 그 파일 하나만
      # 순수 접두어 비교였을 때는 `scope: src/lib/safety`(슬래시 누락) 가
      # `src/lib/safetyX/evil.ts` 까지 열어 주는 fail-open 이 있었다(재현 확인).
      # 슬래시를 빠뜨리면 이제 아무것도 매치되지 않아 차단된다(fail-closed).
      case "$s" in
        */) case "$f" in "$s"*) ok=1; break ;; esac ;;
        *)  [ "$f" = "$s" ] && { ok=1; break; } ;;
      esac
    done <<EOF
$scope
EOF
    [ "$ok" -eq 0 ] && printf '%s\n' "$f"
  done <<EOF
$MATCHED
EOF
}

