  '^scripts/git-hooks/'
  '^scripts/install-git-hooks\.sh$'
  '^scripts/test-git-hooks\.sh$'
)

TASKS_DIR="agent-vault/10-Flow/tasks"

# --- Reviewer 판정의 검토 범위(scope) 강제 여부 -----------------------------
# 1 = 필수. Reviewer 는 `최종 판정: PASS (scope: src/lib/safety/, ...)` 처럼 자신이 실제로
#     검토한 경로를 밝혀야 하고, staged 된 안전파일이 그 범위 밖이면 커밋이 차단된다.
#     이것이 REV-025 CRITICAL("차용된 정당성" — 무관한 과거 task ID 를 인용해 아무 안전코드나
#     통과시키는 우회)을 실제로 막는 유일한 장치다.
# 0 = scope 없으면 경고만 하고 통과(= CRITICAL 재발). 운영 마찰이 과도할 때 Leader 판단으로만
#     내릴 것. 안전장치의 기본값은 fail-closed 여야 하므로 1 을 기본으로 둔다.
REQUIRE_SCOPE=1

# --- staged 파일 목록 ------------------------------------------------------
# T-075 Stage 2 (Reviewer 지적 2 — 비 ASCII 파일명 fail-open):
#   `-z` 없이 읽으면 git 이 core.quotePath(기본 true) 때문에 비 ASCII 이름을
#   `"src/lib/safety/\355\225\234.ts"` 처럼 따옴표·8진수로 인용해 내보내고, 그러면 `^src/…` 앵커가
#   맞지 않아 안전 파일이 검사 없이 통과했다. `core.quotePath=false` 만으로는 부족하다 — 따옴표(")·
#   역슬래시·탭이 든 이름은 그래도 인용된다(git 2.34.1 실측). `-z` 는 이름을 원문 그대로 내보내므로
#   NUL 을 줄바꿈으로 바꿔 기존 줄 단위 파싱에 그대로 넘긴다.
#   (이름에 줄바꿈이 든 파일은 여러 줄로 쪼개지지만, 첫 조각이 원래 경로의 앞부분이라 디렉토리 항목은
#    여전히 매치되고 파일 항목은 과도차단 쪽으로만 틀린다 — fail-closed.)
#   `set -o pipefail` 은 필수다: 파이프의 종료코드는 기본이 마지막 명령(tr)이라, 없으면 git 이 실패해도
#   0 이 되어 아래 "목록을 읽지 못하면 차단"이 fail-open 으로 바뀐다. 명령 치환 안에서만 켠다.
if git rev-parse --verify -q HEAD >/dev/null 2>&1; then
  STAGED="$(set -o pipefail; git diff --cached --name-only --no-renames -z | tr '\0' '\n')"
else
  EMPTY_TREE="$(git hash-object -t tree /dev/null)"
  STAGED="$(set -o pipefail; git diff --cached --name-only --no-renames -z "$EMPTY_TREE" | tr '\0' '\n')"
fi
if [ $? -ne 0 ]; then
  say "❌ [commit-msg] staged 파일 목록을 읽지 못했습니다 (안전상 커밋을 차단합니다)."
  exit 1
fi

[ -z "$STAGED" ] && exit 0

# 패턴들을 하나의 ERE 로 결합
SAFETY_RE=""
for p in "${SAFETY_PATHS[@]}"; do
  if [ -z "$SAFETY_RE" ]; then SAFETY_RE="$p"; else SAFETY_RE="$SAFETY_RE|$p"; fi
done

# T-075 Stage 3 (Codex C2 지적 1 — Reviewer 채택): 바로 아래 "출력이 비면 통과"는 훅에서
# 빈 결과를 통과로 읽는 유일한 지점이다. 그래서 grep 의 종료코드를 반드시 구분한다.
#   0 = 매치 · 1 = 정상 비매치 · 2 이상 = 오류(잘못된 정규식·실행 실패·강제 종료) → 차단.
#   이전에는 오류도 "안전 경로 없음"으로 읽혔다. 가장 그럴듯한 원인은 SAFETY_PATHS 편집 오타
#   (닫히지 않은 괄호 한 글자)였고, 그러면 **모든 커밋이 조용히 통과**했다. 이제는 모든 커밋이
#   소리 내며 막힌다(fail-closed).
#   `LC_ALL=C` + `-a`: 비 UTF-8 이름(EUC-KR 등)이 있으면 UTF-8 로케일의 grep 이 "binary file matches"
#   만 내고 stdout 을 비운 채 rc 0 으로 끝나 통과했다. 둘 중 하나만으로도 막히지만 함께 둔다(무해).
#   SAFETY_PATHS 는 ASCII 정규식뿐이라 C 로케일에서도 뜻이 같다.
MATCHED="$(printf '%s\n' "$STAGED" | LC_ALL=C grep -aE "$SAFETY_RE")"
MATCH_RC=$?
if [ "$MATCH_RC" -gt 1 ]; then
  say "❌ [commit-msg] 안전 경로 판별(grep)이 오류로 끝났습니다 (rc=$MATCH_RC) — 안전상 커밋을 차단합니다."
  say "   원인 후보: SAFETY_PATHS 정규식 오타(괄호·대괄호 짝) 또는 grep 실행 실패. 위 grep 오류 문구를 확인하세요."
  exit 1
fi

# 안전 관련 파일이 없으면 통과 — 문서/UI/vault 전용 커밋을 막지 않는다
[ -z "$MATCHED" ] && exit 0

# --- 커밋 메시지 본문 (주석·verbose diff 제거) ------------------------------
COMMENT_CHAR="$(git config --get core.commentChar 2>/dev/null || true)"
[ -z "$COMMENT_CHAR" ] && COMMENT_CHAR='#'
[ "$COMMENT_CHAR" = "auto" ] && COMMENT_CHAR='#'

msg_body() {
  # 1) `# ------ >8 ------` scissors 이후(= commit -v 의 raw diff)는 전부 버린다
  #    → diff 안에 우연히 들어 있는 T-NNN 문자열로 검사가 통과되는 fail-open 방지
  # 2) 주석(#) 줄도 버린다 → 템플릿/안내문의 T-NNN 도 인정하지 않는다
  awk -v cc="$COMMENT_CHAR" '
    substr($0, 1, 1) == cc && index($0, ">8") > 0 { exit }
    substr($0, 1, 1) == cc { next }
    { print }
  ' "$MSG_FILE"
}

# --- task ID 추출 ----------------------------------------------------------
# 토큰 단위로 잘라(영숫자와 '-' 만 남김) 앞이 잘린 오탐(refT-020)과
# 자릿수 초과(T-0255 → T-025 로 오인)를 모두 배제한다.
TASK_IDS="$(msg_body \
  | tr -c 'A-Za-z0-9-' '\n' \
  | grep -oE '^[Tt]-[0-9]{3}([^0-9]|$)' \
  | grep -oE '^[Tt]-[0-9]{3}' \
  | tr '[:lower:]' '[:upper:]' \
  | sort -u)"

print_header() {
  say ""
  say "🛑 커밋 차단 — 안전 관련 코드 변경에는 Reviewer 독립감사 기록이 필요합니다."
  say ""
  say "   staged 된 안전 관련 파일:"
  printf '%s\n' "$MATCHED" | while IFS= read -r f; do [ -n "$f" ] && say "     - $f"; done
  say ""
}

print_footer() {
  say ""
  say "   해결 방법:"
  say "     1) Reviewer 에이전트에게 **지금 staged 된 이 파일들에 대한** 독립감사를 요청한다"
  say "        (과거의 무관한 task 판정을 끌어다 쓰는 것은 우회이며 금지된다)"
  say "     2) Reviewer 가 $TASKS_DIR/T-NNN-*.md 의 '## Reviewer' 섹션 마지막에"
  say "        아래 형식으로 판정을 기록한다 — 마지막 '최종 판정' 줄 하나만 유효하다:"
  say "          최종 판정: PASS (scope: src/lib/safety/, src/app/api/orders/)"
  say "        · 판정은 PASS / CONDITIONAL_PASS / FAIL 중 리터럴 대문자"
  say "        · scope 는 실제로 검토한 경로들. staged 안전파일이 전부 이 범위 안이어야 통과"
  say "     3) 커밋 메시지에 해당 task ID(예: T-025)를 포함해 다시 커밋한다"
  say ""
  say "   ⚠ 오탐이라고 판단되면 사용자(사람)만 아래로 우회할 수 있습니다:"
  say "        git commit --no-verify"
  say "      (에이전트가 임의로 --no-verify 를 쓰는 것은 금지 — 이 훅의 존재 이유입니다)"
  say ""
}

if [ -z "$TASK_IDS" ]; then
  print_header
  say "   ✗ 커밋 메시지에 task ID(T-NNN)가 없습니다."
  say "     안전 관련 파일이 포함된 커밋은 어떤 task 의 산출물인지 반드시 밝혀야 합니다."
  print_footer
  exit 1
fi

# --- task 별 Reviewer 판정 확인 --------------------------------------------
reviewer_body() {
  # '##' 이상 헤딩 중 제목에 reviewer 가 들어간 섹션의 본문만 출력
  # (다음 헤딩을 만나면 종료 → QA 섹션의 "Reviewer PASS" 언급은 인정하지 않는다)
  awk '
    /^##+[ \t]/ { in_rev = (tolower($0) ~ /reviewer/) ? 1 : 0; next }
    in_rev { print }
  ' "$1"
}

# --- 판정 해석 (H3: 마지막 "최종 판정" 줄 하나만 권위 있는 판정) -------------
#
# 이전 구현은 Reviewer 섹션 어딘가에 `PASS` 문자열이 있기만 하면 통과시켰다.
# 그 결과 ① 라운드1 PASS 뒤에 라운드2 FAIL 이 와도 통과 ② 결함을 *설명하는* 산문이
# 판정 단어를 인용하기만 해도 통과 — 라는 fail-open 이 있었다(REV-025 H3).
# 이제는 "최종 판정" 이 들어간 줄만 판정으로 인정하고, 그중 **마지막 줄**을 채택한다.
#
# 인정 포맷(마크다운 장식·타임스탬프 접두는 허용):
#   최종 판정: PASS (scope: src/lib/exchanges/, src/app/api/orders/)
#   - [10:40] **최종 판정: CONDITIONAL_PASS (scope: src/lib/safety/)**
#   **정정된 최종 판정: FAIL**
verdict_line() {
  # 마지막 "최종 판정" 줄 (없으면 빈 문자열)
  printf '%s\n' "$1" | grep -E '최종[[:space:]]*판정' | tail -1
}

verdict_of() {
  # 줄에서 첫 판정 토큰을 뽑는다. grep -E 는 leftmost-longest 이므로
  # CONDITIONAL_PASS 안의 PASS 가 아니라 CONDITIONAL_PASS 전체가 잡힌다.
  printf '%s\n' "$1" | grep -oE '(^|[^A-Za-z])(CONDITIONAL_PASS|PASS|FAIL)([^A-Za-z]|$)' \
    | grep -oE '(CONDITIONAL_PASS|PASS|FAIL)' | head -1
}

scope_of() {
  # `(scope: a/, b/)` → "a/ b/"  (없으면 빈 문자열)
  printf '%s\n' "$1" \
    | grep -oE 'scope:[[:space:]]*[^)]*' | head -1 \
    | sed 's/^scope:[[:space:]]*//' \
    | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$'
}

# staged 안전파일이 전부 scope 접두어 안에 들어가는지 — 아니면 목록 반환
files_out_of_scope() {
  local scope="$1" f s ok
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    ok=0
    while IFS= read -r s; do
      [ -z "$s" ] && continue
      # 경계 있는 매칭 (REV-025 라운드4 HIGH):
      #   `src/lib/safety/` 처럼 '/' 로 끝나면 → 디렉토리 접두어 매칭
      #   `src/lib/auth/session.ts` 처럼 아니면 → 정확히 그 파일 하나만
      # 순수 접두어 비교였을 때는 `scope: src/lib/safety`(슬래시 누락) 가
      # `src/lib/safetyX/evil.ts` 까지 열어 주는 fail-open 이 있었다(재현 확인).
      # 슬래시를 빠뜨리면 이제 아무것도 매치되지 않아 차단된다(fail-closed).
      case "$s" in
        */) case "$f" in "$s"*) ok=1; break ;; esac ;;
        *)  [ "$f" = "$s" ] && { ok=1; break; } ;;
      esac
    done <<EOF
$scope
EOF
    [ "$ok" -eq 0 ] && printf '%s\n' "$f"
  done <<EOF
$MATCHED
EOF
}

# 구 형식(2026-08-16 이전) task 파일에 공통으로 붙이는 안내.
# 판정 줄이 아예 없거나(옛 자유서술 형식), 있어도 scope 표기가 없는 경우 모두 여기로 온다.
OLDFMT_HINT="
          · 2026-08-16 이전 판정은 **전부 무효**입니다 — 그 판정이 지금 staged 된 파일을
            실제로 검토한 것인지 확인할 방법이 없기 때문입니다(REV-025 CRITICAL '차용된 정당성').
          · 고치는 법: Reviewer 가 **지금 이 커밋의 파일들**을 감사한 뒤, 그 task 의
            '## Reviewer' 섹션 **맨 마지막 줄**에 아래 한 줄을 추가합니다.
              최종 판정: PASS (scope: <실제로 검토한 경로들, 콤마 구분>)
          · 그 줄은 '## Reviewer' 헤딩 바로 아래 본문에 있어야 합니다 — 제목에 'Reviewer' 가
            없는 소제목(예: '### 종합')이 먼저 나오면 스캔이 거기서 끊겨 인식되지 않습니다.
          · 과거 판정에 scope 만 덧붙이지 마세요. 검토하지 않은 경로를 scope 에 적는 것은
            --no-verify 오남용과 동급입니다."

# --- 다중 task 결합 커밋 지원 (요구사항4 복원, REV-025 라운드2) -----------------
#
# 원 요구사항4: "여러 T-ID 를 참조하면 그중 하나라도 Reviewer 판정이 있으면 통과"
# (T-017+T-018 처럼 함께 검토한 여러 task 를 한 커밋에 묶는 기존 관행 보존).
# scope 강제를 도입하면서 이 경로가 실질 봉쇄됐다 — 각 task 가 **단독으로** staged 파일
# 전부를 덮어야만 통과했기 때문이다. 두 task 가 각자 자기 몫을 검토한 정상적인 결합
# 커밋조차 막힌다.
#
# → 유효 판정을 가진 task 들의 scope 를 **합집합**으로 모아 대조한다.
#   ⚠ 합집합에 기여하는 것은 **신형식(scope 를 가진) 유효 판정뿐**이다.
#     구 형식·FAIL·판정 없음인 task 는 아무것도 기여하지 못한다 — 그렇지 않으면
#     "구 형식 task 를 하나 끼워 넣어 범위를 넓힌다"는 새 우회로가 생긴다.
UNION_SCOPE=""     # 기여된 scope 항목들 (개행 구분)
CONTRIB=""         # 합집합에 기여한 task ID 목록
SCOPE_WAIVED=0     # REQUIRE_SCOPE=0 완화 모드에서 scope 없는 유효 판정을 만난 경우
REASONS=""
shopt -s nullglob

for id in $TASK_IDS; do
  files=( "$TASKS_DIR/$id-"*.md )
  if [ ${#files[@]} -eq 0 ]; then
    REASONS="$REASONS
     ✗ $id — $TASKS_DIR/$id-*.md 가 없습니다 (task 이력서부터 작성하세요)"
    continue
  fi

  id_ok=""
  id_reason=""
  for tf in "${files[@]}"; do
    body="$(reviewer_body "$tf")"
    if [ -z "$body" ]; then
      id_reason="'## Reviewer' 섹션이 없거나 비어 있습니다 ($tf)$OLDFMT_HINT"
      continue
    fi

    vline="$(verdict_line "$body")"
    if [ -z "$vline" ]; then
      id_reason="**구 형식** — Reviewer 섹션에 '최종 판정: ...' 줄이 없습니다 ($tf)$OLDFMT_HINT"
      continue
    fi

    verdict="$(verdict_of "$vline")"
    case "$verdict" in
      PASS|CONDITIONAL_PASS) ;;
      FAIL)
        id_reason="마지막 '최종 판정' 줄이 FAIL 입니다 — 결함 해소 후 재감사가 필요합니다 ($tf)
          · 앞쪽에 PASS 기록이 있어도 **마지막 판정 줄 하나만** 유효합니다(판정이 엇갈린
            문서는 신뢰할 수 없다는 것이 REV-025 의 교훈입니다).
          · 이미 무효가 된 낡은 판정은 지우거나 '## 폐기된 판정 이력' 섹션으로 이관하세요.
            ⚠ 이관 시 **소제목에 'Reviewer' 단어를 쓰지 마세요** — 이 훅은 제목에 그 단어가
              든 '##+' 헤딩을 전부 Reviewer 섹션으로 스캔하므로, 폐기한 판정이 되살아나
              fail-open 이 됩니다."
        continue ;;
      *)
        id_reason="'최종 판정' 줄에서 판정(PASS/CONDITIONAL_PASS/FAIL)을 읽지 못했습니다 ($tf)"
        continue ;;
    esac

    # --- scope 대조 (CRITICAL: "차용된 정당성" 차단) ---
    scope="$(scope_of "$vline")"
    if [ -z "$scope" ]; then
      if [ "$REQUIRE_SCOPE" -eq 1 ]; then
        id_reason="**구 형식** — 판정에 검토 범위(scope) 표기가 없습니다 ($tf)$OLDFMT_HINT"
        continue
      fi
      say "⚠ [commit-msg] $id: 최종 판정에 scope 가 없어 staged 파일과의 관련성을 검증하지 못했습니다 ($tf)"
      SCOPE_WAIVED=1
    else
      # 개별 task 가 staged 파일 전부를 덮지 못해도 여기서 탈락시키지 않는다 —
      # 다른 task 의 scope 와 합쳐 최종 판단한다(요구사항4).
      UNION_SCOPE="$UNION_SCOPE
$scope"
    fi

    id_ok="$tf"
    break
  done

  if [ -n "$id_ok" ]; then
    CONTRIB="$CONTRIB $id"
  else
    REASONS="$REASONS
     ✗ $id — $id_reason"
  fi
done

OOS=""
if [ -n "$CONTRIB" ]; then
  if [ "$SCOPE_WAIVED" -eq 1 ]; then
    say "✅ [commit-msg] Reviewer 감사 기록 확인:$CONTRIB (⚠ scope 미검증 — REQUIRE_SCOPE=0)"
    exit 0
  fi
  OOS="$(files_out_of_scope "$UNION_SCOPE")"
  if [ -z "$OOS" ]; then
    say "✅ [commit-msg] Reviewer 감사 기록 확인:$CONTRIB"
    exit 0
  fi
fi

print_header
say "   참조된 task ID: $(printf '%s' "$TASK_IDS" | tr '\n' ' ')"

if [ -n "$OOS" ]; then
  say "   유효 판정이 확인된 task:$CONTRIB"
  say ""
  say "   ✗ 아래 파일이 그 판정들의 검토 범위(scope) **합집합 밖**입니다 —"
  say "     인용한 판정들은 이 파일을 검토한 것이 아닙니다:"
  printf '%s\n' "$OOS" | while IFS= read -r f; do [ -n "$f" ] && say "          · $f"; done
  say ""
  say "     검토된 범위(합집합): $(printf '%s' "$UNION_SCOPE" | tr '\n' ' ' | sed 's/^ *//')"
  say "     ※ scope 항목이 '/' 로 끝나면 그 디렉토리 하위 전체, 끝나지 않으면 그 파일 하나만"
  say "       뜻합니다. 디렉토리를 의도했다면 끝에 '/' 를 붙였는지 확인하세요."
fi

[ -n "$REASONS" ] && say "$REASONS"
print_footer
exit 1
