#!/usr/bin/env bash
#
# commit-msg hook — "안전 관련 코드 커밋은 Reviewer 독립감사 기록이 있어야만 통과"
#
# 발단: 2026-08-13, T-023 / T-024 가 Reviewer 독립감사 없이 커밋·push·배포까지
#       끝나 있던 절차 위반이 (우연히) 발견됨. 표준 순환 Developer→Reviewer→QA 에서
#       Reviewer 단계가 통째로 생략된 채 실계좌에 반영된 첫 사례.
#       재발 방지를 위해 절차를 문서가 아니라 기계로 강제한다. (task: T-025)
#
# 동작:
#   1) staged diff 에 "안전 관련 경로"(아래 SAFETY_PATHS) 파일이 하나도 없으면 → 통과.
#      문서·UI·vault·설정 전용 커밋은 절대 막지 않는다.
#   2) 있으면 커밋 메시지에서 task ID(T-NNN) 를 뽑는다. 없으면 → 차단.
#   3) 각 task ID 에 대해 agent-vault/10-Flow/tasks/T-NNN-*.md 를 찾고,
#      그 파일의 "Reviewer" 섹션(## 로 시작하고 제목에 Reviewer 가 들어간 섹션)에서
#      **"최종 판정" 이 들어간 마지막 줄 하나**를 권위 있는 판정으로 채택한다.
#        - 판정이 FAIL 이거나 판정 줄 자체가 없으면 → 차단
#        - PASS / CONDITIONAL_PASS 이면, 그 줄의 `(scope: ...)` 와 staged 안전파일을 대조해
#          하나라도 범위 밖이면 → 차단 (REQUIRE_SCOPE=1, 아래 L8 참조)
#      예: `- [10:40] **최종 판정: PASS (scope: src/lib/safety/, src/app/api/orders/)**`
#   4) 여러 task ID 를 참조하면 그중 하나라도 위 조건을 만족하면 통과
#      (여러 task 를 한 커밋에 묶는 기존 관행 보존 — 예: T-017+T-018 동시 배포).
#
# 우회: 사용자는 언제든 `git commit --no-verify` 로 우회할 수 있다(의도된 설계).
#       단 이는 사용자 권한이며, 에이전트가 임의로 쓰는 것은 금지한다.
#
# 알려진 한계 (Reviewer 검토용 — 의도적으로 여기 명시):
#   L1. `core.hooksPath` 는 clone 마다 로컬 설정이라, 새 clone/새 머신에서는
#       `bash scripts/install-git-hooks.sh` 를 실행하기 전까지 이 훅이 비활성이다.
#       git 자체가 저장소 내용으로 훅을 강제 실행하는 기능을 (보안상) 제공하지 않으므로
#       완전 자동화는 불가능하다. 서버측 강제가 필요하면 Gitea pre-receive 로 별도 구현해야 한다.
#   L2. `git commit --amend` 로 이미 커밋된 안전 파일 변경을 고칠 때, staged diff 가
#       비어 있으면 이 훅은 통과시킨다(amend 여부를 commit-msg 훅에서 알 방법이 없음).
#   L3. merge commit(충돌 해결 커밋)도 일반 커밋과 동일하게 검사한다. 막히면 --no-verify.
#   L4. 구 형식 task 파일(T-001 등, Reviewer 판정이 `## 진행 로그` 안에 섞여 있는 형식)은
#       Reviewer 섹션이 없어 차단된다. 해당 파일에 `## Reviewer` 섹션을 추가하거나 --no-verify.
#   L5. `core.commentChar=auto` 인 경우 주석 문자를 알 수 없어 '#' 로 가정한다.
#   L6. 🔴 **이 검사는 `## Reviewer` 섹션에 PASS 문자열이 "존재하는지"만 확인하며, 그것을 실제
#       Reviewer 에이전트가 작성했는지는 전혀 검증하지 않는다(self-attestation 우회).** 즉 누구든
#       task 파일의 Reviewer 섹션에 스스로 `PASS` 를 적어 넣으면 독립감사 없이 통과된다.
#       순수 bash·신규 의존성 금지 제약상 작성자 인증(서명·별도 신뢰 저장소)은 이번 범위 밖이다.
#       ⇒ **Reviewer 섹션에 스스로 PASS 를 적어 넣는 행위는 `--no-verify` 오남용과 동급으로 금지한다.**
#       이 훅은 "잊고 지나치는 사고"를 막는 장치이지, 의도적 우회를 막는 장치가 아니다.
#   L8. 🔴 **"차용된 정당성"(REV-025 CRITICAL)** — 훅은 인용된 task 에 유효한 판정이 있는지 볼 뿐,
#       그 판정이 *지금 staged 된 파일* 을 실제로 검토한 결과인지는 `scope` 대조로만 알 수 있다.
#       REQUIRE_SCOPE=1 이 이를 강제하지만, Reviewer 가 scope 를 실제 검토 범위보다 넓게 적어 주면
#       (예: `scope: src/`) 검사는 다시 무의미해진다. 이 마지막 한 칸은 코드로 못 막는다.
#       ⇒ **무관한 과거 task ID 를 편의상 인용하는 것, 검토하지도 않은 경로를 scope 에 적는 것은
#         `--no-verify` 오남용과 동급으로 금지한다.** 이 프로젝트 vault 문화상 `related_tasks` 로
#         과거 task 를 엮는 게 일상적이라 **악의 없이도 쉽게 트리거되니** 특히 주의할 것.
#   L7. shim 모드(아래 L1 참조)에서는 `install-git-hooks.sh` 실행 시점에 존재하던 훅 이름만 shim 이
#       생성된다. **새 훅 파일(pre-commit, pre-push 등)을 `scripts/git-hooks/` 에 추가한 뒤
#       `install-git-hooks.sh` 를 재실행하지 않으면 그 훅은 아무 경고 없이 무음으로 비활성**이다
#       (기존 훅 이름의 내용 변경은 shim 이 원본을 그대로 읽어 실행하므로 재실행 불필요).
#       ⇒ 훅 파일을 새로 추가하면 반드시 `bash scripts/install-git-hooks.sh` 를 다시 실행할 것.
#       완화(2026-08-16): 아래 `check_hook_sync()` 가 매 커밋마다 원본↔shim 을 대조해 경고한다.
#       "재실행을 잊는 것"이 바로 이 실패모드라 설치 스크립트만으로는 감지가 불가능하기 때문이다.
#       단 경고일 뿐 차단은 하지 않으므로, 경고를 무시하면 그 훅은 여전히 비활성이다.
#
set -u

MSG_FILE="${1:-}"

say() { printf '%s\n' "$*" >&2; }

if [ -z "$MSG_FILE" ] || [ ! -f "$MSG_FILE" ]; then
  say "❌ [commit-msg] 커밋 메시지 파일 인자를 받지 못했습니다 (안전상 커밋을 차단합니다)."
  say "   훅을 직접 테스트하려면: bash scripts/git-hooks/commit-msg <메시지파일>"
  exit 1
fi

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$ROOT" ]; then
  say "❌ [commit-msg] git 저장소 루트를 찾지 못했습니다 (안전상 커밋을 차단합니다)."
  exit 1
fi
cd "$ROOT" || exit 1

# ---------------------------------------------------------------------------
# shim 동기화 점검 (L7 대응) — **경고만 한다. 절대 커밋을 막지 않는다.**
#
# shim 모드에서는 `install-git-hooks.sh` 실행 시점에 존재하던 훅 이름만 shim 이 생성된다.
# 그 뒤 `scripts/git-hooks/` 에 새 훅(pre-commit, pre-push …)을 추가하고 재설치하지 않으면
# git 은 그 훅을 **아무 경고 없이 완전히 무시**한다(hooksPath 에 해당 이름의 파일이 없으므로).
# 설치 스크립트도 이를 감지하지만 "재실행을 잊었을 때"가 바로 문제 상황이라 소용이 없다.
# → 매 커밋마다 실행되는 이 훅이 직접 대조해 알린다.
#
# 차단하지 않는 이유: 비활성인 것은 *다른* 훅이고, 이 훅 자신은 정상 동작 중이다.
# 여기서 커밋을 막으면 shim 디렉토리 문제로 저장소 전체가 잠길 수 있다(복구는 --no-verify).
# 검사 자체의 실패가 커밋을 막는 일이 없도록 전 구간 fail-safe 로 둔다.
# ---------------------------------------------------------------------------
check_hook_sync() {
  local hp abs n base missing=""
  hp="$(git config --get core.hooksPath 2>/dev/null || true)"
  [ -z "$hp" ] && return 0
  case "$hp" in /*) abs="$hp" ;; *) abs="$ROOT/$hp" ;; esac
  # 저장소 안 훅 디렉토리를 직접 가리키는 direct 모드면 드리프트가 구조적으로 없다
  [ "$abs" = "$ROOT/scripts/git-hooks" ] && return 0
  [ -d "$abs" ] || return 0
  [ -d "$ROOT/scripts/git-hooks" ] || return 0
  for n in "$ROOT"/scripts/git-hooks/*; do
    [ -f "$n" ] || continue
    base="$(basename "$n")"
    case "$base" in *.md|*.txt|*.sample|.*) continue ;; esac
    [ -e "$abs/$base" ] || missing="$missing $base"
  done
  if [ -n "$missing" ]; then
    say ""
    say "⚠ [commit-msg] 아직 설치되지 않은 훅이 있습니다:$missing"
    say "   shim 모드는 설치 시점에 있던 훅만 활성화합니다 — 위 훅은 지금 **무음으로 비활성**입니다."
    say "   → bash scripts/install-git-hooks.sh 를 다시 실행하세요."
    say "   (이 경고 자체는 커밋을 막지 않습니다)"
    say ""
  fi
}
# `|| true` 만 붙인다 — 검사 실패가 커밋을 막지 않게 하되, 경고 자체는 stderr 로 보여야 한다
# (2>/dev/null 을 붙이면 say() 출력까지 삼켜서 이 검사가 무의미해진다).
check_hook_sync || true

