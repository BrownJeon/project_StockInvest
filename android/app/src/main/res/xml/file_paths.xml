<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 공유 범위 — Capacitor 코어(BridgeWebChromeClient)가 카메라 촬영 임시 파일을 만드는 곳 하나뿐이다:
    activity.getExternalFilesDir(Environment.DIRECTORY_PICTURES) = 앱 전용 외부 저장소의 Pictures/.
    템플릿 기본값(external-path "." = 공유 외부 저장소 전체, cache-path ".")은 이 앱이 쓰지 않아 뺐다(T-084 R1).
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-files-path name="capture_images" path="Pictures/" />
</paths>
