<?xml version="1.0" encoding="utf-8"?>
<!--
  T-084 스플래시(안드로이드 12 미만 + Capacitor 예전 방식) — 바탕 #0f1115 가운데 앱 아이콘(지름 192dp 원).
  styles.xml AppTheme.NoActionBarLaunch 의 android:background 와 @capacitor/splash-screen 의 예비 경로(리소스 이름 "splash")가
  이 drawable 을 쓴다. 안드로이드 12+ 시스템 스플래시는 같은 테마의 windowSplashScreenBackground·windowSplashScreenAnimatedIcon 을 쓴다
  — 두 경로가 같은 그림(ic_splash_icon, 288dp)이 되게 맞췄다. 템플릿의 splash.png(Capacitor 로고)는 지웠다.
  앱 이름 글자는 넣지 않는다(벡터에 글자를 넣을 수 없고, 12+ 시스템 스플래시도 아이콘만 그린다).
  ⚠ 이 파일을 바꾸는 것은 네이티브 변경이다 — APK 재빌드 + versionCode 증가.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />
    <item
        android:drawable="@drawable/ic_splash_icon"
        android:gravity="center"
        android:width="288dp"
        android:height="288dp" />
</layer-list>
