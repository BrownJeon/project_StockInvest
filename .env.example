# Server
PORT=3003
NODE_ENV=development

# ─── 앱 인증 (필수 — Phase 0 → T-008 회원제) ─────────────────────────────────
# 세션 쿠키 HMAC 서명 키. 미설정 시 /api/health, /login, /signup, /api/auth/* 를 제외한
# 모든 라우트가 503 으로 차단된다(fail-closed). 변경하면 기존 세션이 전부 무효화된다.
# 생성: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SESSION_SECRET=

# 회원별 KIS 자격증명 암호화 키 (AES-256-GCM). **디코딩 결과가 정확히 32바이트**여야 한다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ 분실하면 저장된 전 회원 KIS 키를 복호화할 수 없다 — 전원 재입력이 필요하다. 별도 백업 필수.
CREDENTIALS_ENCRYPTION_KEY=

# 회원가입 초대 코드 (선택이지만 인터넷 공개 서버에서는 사실상 필수).
#   설정됨   → 가입 시 이 코드를 정확히 입력해야 계정을 만들 수 있다
#   미설정   → **가입 개방** (누구나 계정 생성 가능) + 부팅·시도마다 경고 로그
# 이 앱은 nginx vhost(stock.미라클펭귄.com)로 인터넷에 노출돼 있고 basic-auth·IP 제한이 없다.
# 설계문서가 "KIS 키 실검증이 사실상의 가입 제한"이라 가정했으나(문서 line 28),
# 가입에서 KIS 입력이 빠지면서(사용자 결정 Q1) 그 제한을 이 코드가 대신한다.
SIGNUP_INVITE_CODE=

# [DEPRECATED — T-008(2026-08-07)] AUTH_PIN 은 더 이상 코드에서 읽지 않는다.
# PIN 로그인은 이메일·비밀번호 회원제로 대체됐고, 세션 서명 키는 AUTH_SESSION_SECRET 으로 분리됐다.
# 이 줄은 과거 설정 파일과의 대조용 기록일 뿐이며 값을 채워도 아무 효과가 없다.
# AUTH_PIN=
# 주의: middleware 는 Edge Runtime 에서 동작한다. .env 변경 후에는 반드시
#       `pm2 restart stockinvest --update-env` (배포 시에는 재빌드)로 프로세스를 재시작해야 반영된다.

# NAS MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PWD=
DB_NAME=stockinvest

# ─── 한국투자증권 KIS OpenAPI ─────────────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=        # 계좌번호 (숫자 8자리)
KIS_ACCOUNT_PRODUCT=01 # 상품코드 (주식현물=01)
KIS_MOCK=true          # true=모의투자, false=실전투자

# ─── 안전장치 ────────────────────────────────────────────────────────────────
DRY_RUN=true                      # true면 실제 거래소 API 호출 없이 로그만 기록
KILL_SWITCH=false                 # true면 모든 주문 즉시 차단
# API_USAGE_LOG_DIR=/tmp/stockinvest-logs  # 외부 API 호출 기록 경로(T-040). 비우면 <cwd>/logs. NFS 트리에서 dev 서버를 직접 돌릴 때만 로컬 디스크로 지정(NFS 정지 시 앱 멈춤 방지)

# ─── 주문 한도 (실효값은 DB system_config 가 SSOT) ────────────────────────────
# 실효 한도 = 해당 시장(국내/해외) 포트폴리오 평가액 × pct%.
#   1회 : system_config `safety_order_max_pct`        (설정 > 안전장치 UI에서 변경)
#   일일 : system_config `safety_daily_order_max_pct`
# 앱 부팅 시 각각 5 / 10 이 INSERT IGNORE 로 시드된다(기존 값은 덮어쓰지 않음).
#
# fail-safe (Phase 0): DB 키가 없거나 포트폴리오 평가액 조회에 실패하면 한도는 **0**이 되고
#                      신규 매수가 전면 차단된다. (이전에는 Infinity = 무제한이었다 — fail-open)
# 아래 env 값은 **참고용 문서**이며 코드에서 읽지 않는다.
ORDER_MAX_PCT=5                   # (참고) 1회 주문 = 시장 평가액의 %
DAILY_ORDER_MAX_PCT=10            # (참고) 일일 누적 = 시장 평가액의 %

# ─── [deprecated] 고정 KRW 한도 ─────────────────────────────────────────────
# 2026-04-26 정책 변경으로 pct 단일 기준이 되면서 **코드에서 더 이상 읽지 않는다**(사문 변수).
# 전면 정리는 Phase 2 문서 단계에서 수행. 값이 남아 있어도 동작에 영향 없음.
# ORDER_MAX_KRW=100000
# DAILY_ORDER_MAX_KRW=500000
# ORDER_MAX_DOMESTIC_KRW=100000
# DAILY_ORDER_MAX_DOMESTIC_KRW=500000
# ORDER_MAX_OVERSEAS_KRW=50000
# DAILY_ORDER_MAX_OVERSEAS_KRW=300000

# ─── 블랙리스트 (거래정지·관리종목 등) ───────────────────────────────────────
# 정책: 화이트리스트 폐기. universe + 보유 심볼만 평가하되, 명시적 차단할 종목만 등록.
# 비워두면 차단 없음. settings UI에서 직접 등록·삭제 가능.
BLOCKED_SYMBOLS_DOMESTIC=
BLOCKED_SYMBOLS_OVERSEAS=

# ─── 해외주식 (KIS overseas) ─────────────────────────────────────────────────
KIS_OVERSEAS_ENABLED=true              # false면 해외 어댑터·잔고 조회 비활성
KIS_OVERSEAS_DEFAULT_EXCHANGE=NAS      # NAS|NYS|AMS — 기본 거래소

# ─── 환율 (USD/KRW) ──────────────────────────────────────────────────────────
# 외부 API 폴백 실패 시 사용할 정적 환율 (대략적인 시세, 운영자가 주기적 업데이트)
FX_USDKRW_FALLBACK=1380

# ─── 매매 전략 프로파일 ────────────────────────────────────────────────────────
DEFAULT_TRADING_STYLE=swing       # scalp | day | swing | position | dca
ASSET_PROFILE_CRYPTO_SKIP_VERIFY=auto
ASSET_PROFILE_STOCK_SKIP_VERIFY=false

# ─── 시그널 / 분석가 ──────────────────────────────────────────────────────────
SIGNAL_AUTO_SUBMIT_MAX_KRW=50000
SIGNAL_DEFAULT_TTL_MIN=30
ANALYST_ENABLED=false

# ─── AI 필터 (Anthropic Claude SDK) ──────────────────────────────────────────
# analyst 기반 시그널을 Claude로 2차 필터링. 미설정 시 AI 필터 스킵.
ANTHROPIC_API_KEY=

# ─── 변동폭 가드 ────────────────────────────────────────────────────────────
VOL_GUARD_ENABLED=false
VOL_GUARD_WINDOW_MIN=60
VOL_GUARD_WARN_PCT=-2
VOL_GUARD_BLOCK_PCT=-4
VOL_GUARD_PANIC_PCT=-7

# ─── Universe (동적 종목 선별) ─────────────────────────────────────────────────
UNIVERSE_ENABLED=true

# ─── 크론 보안 (필수) ──────────────────────────────────────────────────────────
# /api/cron/* 는 이 시크릿 헤더(x-cron-secret)로만 통과한다 (middleware + 라우트 이중 방어).
# 미설정 시 모든 cron 라우트가 401 로 차단된다(fail-closed) — cron 이 통째로 멈추므로 반드시 설정.
CRON_SECRET=

# ─── Slack 알람 ───────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Telegram 알람 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── LLM Provider (AI 분석가 호출 백엔드) ───────────────────────────────────
# DB system_config.llm_provider 가 있으면 그 값을 우선 사용 (UI에서 런타임 변경 가능)
LLM_PROVIDER=claude               # claude | ollama | home-m4-api (기본 claude)

# Ollama 사용 시 — 다른 서버에 호스팅된 Ollama HTTP API 연동
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.3

# home-m4-api 사용 시 — 자체 운영 LLM 허브 (POST /v1/chat, X-API-Key 헤더)
# .env 값은 초기값. UI(/settings)에서 변경 시 DB(system_config)에 저장되며 DB가 우선.
# AI_API_KEY 는 보안상 .env 전용 — UI에서 표시·수정 불가.
AI_API_BASE=http://192.168.0.10:8000
AI_API_MODEL=llama3
AI_API_TEMPERATURE=0.3
AI_API_KEY=mk_your_key_here

# ─── RAG 튜닝 (Phase AB + D-1/D-2/D-3) ────────────────────────────────────
# RAG_ENABLED 등 일부는 UI(/settings)에서도 조정 가능. .env 는 초기값.
RAG_ENABLED=true
RAG_TOPK_SIGNALS=5
RAG_TOPK_NEWS=3
RAG_LOOKBACK_DAYS=7              # news/macro 신선도 (일)
RAG_LOOKBACK_DAYS_SIGNALS=30     # D-1: signals 신선도 — 시장 레짐 반영 위해 더 길게
RAG_MIN_SCORE=0.5                # D-2: score 임계값 — bge-m3 기준 < 0.5 노이즈
M4_DEFAULT_EMBED_MODEL=bge-m3    # D-3/D-8: 신규 KB 컬렉션 기본 임베딩 모델

# ─── M4 dataset 업로드 (export-llm-trainset.sh) ────────────────────────────
# scripts/export-llm-trainset.sh 가 매일 03:00 KST 도메인별(domestic/overseas) JSONL 을 업로드.
# 둘 다 비어 있으면 로컬(/tmp)만 저장. 채워지면 curl POST + X-Admin-Token 사용.
# (하위 호환) 환경변수 M4_API_HOST=user@host 만 설정 시 옛 scp 경로 사용.
M4_API_URL=
M4_ADMIN_TOKEN=
# Phase S: 업로드 성공 시 자동 fine-tune 트리거. 1 또는 true 면 ON.
# M4 max_concurrent=1 이므로 두 도메인 중 하나만 큐 진입 가능 (두 번째는 429 무시).
M4_AUTO_TRAIN=

# ─── 소셜 로그인 OAuth (T-009, 2026-08-08) ─────────────────────────────────
# 세 값이 **모두** 채워진 프로바이더만 로그인 화면에 버튼이 나타난다. 비면 버튼 자체가 없다.
# 세션은 기존 AUTH_SESSION_SECRET HMAC 쿠키를 그대로 쓴다 — JWT·localStorage 를 쓰지 않으므로
# JWT_SECRET 류의 추가 키는 필요 없다.
#
# 제공자 콘솔에 등록할 "승인된 리디렉션 URI" (아래 BASE 와 정확히 일치해야 한다):
#   https://stock.미라클펭귄.com/api/auth/google/callback
#   https://stock.미라클펭귄.com/api/auth/github/callback
OAUTH_CALLBACK_BASE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── 가입 요청 → 관리자 Gmail 알림 (T-010, 2026-08-09) ──────────────────────
# 초대코드가 없는 외부인이 /signup/request 에서 요청하면 **관리자에게 메일 한 통**이 간다.
# 그 메일에 요청자 정보와 **현재 SIGNUP_INVITE_CODE 가 함께** 담긴다 —
# 코드를 알려주려고 서버 .env 를 직접 열어보던 과정을 없애는 것이 이 기능의 목적이다.
#
# 🔒 초대코드는 ADMIN_NOTIFY_EMAIL 로만 나간다. 요청자가 적은 주소로는 어떤 경우에도 안 간다.
#
# SMTP_USER · SMTP_PASS · ADMIN_NOTIFY_EMAIL 이 **모두** 채워져야 기능이 켜진다.
# 하나라도 비면 로그인·회원가입 화면의 "초대코드가 없으신가요?" 링크 자체가 렌더되지 않고
# 엔드포인트는 503 을 돌려준다 (OAuth 프로바이더 미설정과 같은 방식).
# 값을 채운 뒤 `pm2 restart stockinvest --update-env` 하면 즉시 켜진다 (재빌드 불필요).
#
# SMTP_PASS 는 **Google 앱 비밀번호 16자리**다. 평소 쓰는 Gmail 비밀번호로는 안 된다:
#   ① Google 계정에 2단계 인증을 먼저 켠다 (안 켜면 앱 비밀번호 메뉴가 보이지 않는다)
#   ② myaccount.google.com → 보안 → 앱 비밀번호 → 이름(예: StockInvest) 입력 후 생성
#   ③ 나온 16자리를 SMTP_PASS 에 붙여넣는다 (공백 없이)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 알림 받을 주소. 사용자 확정 Q4 — SMTP_USER 와 같은 주소를 쓴다.
# (같더라도 **반드시 명시**해야 한다. 암묵적 폴백을 두지 않는다 —
#  설정을 덜 한 채 조용히 어딘가로 발송되는 상태를 만들지 않기 위해서다.)
ADMIN_NOTIFY_EMAIL=

# ─── KIS 해외 현재가상세 스냅샷 1회 실행 마감 (T-145 ⑨, 2026-11-02) ──────────
# 이 잡(kis-fundamentals-snapshot)은 **08:30~08:55 KST 창의 매 틱**에 불리고, 한 호출은 아래 마감 안에서만
# 처리하고 끊는다. 남은 종목은 다음 호출이 DB(`us_fundamentals_snapshot` 의 오늘 행)로 이어받는다.
# 목적은 **08시 틱 길이를 대상 종목 수와 무관하게 묶는 것**이다 — 틱이 300초를 넘으면 HOME-SERVER 순찰이
# `stockinvest-cron` 을 재시작해 무인 실행 루프가 끊긴다(2026-10-29 운영 실측 틱 282초 / 한도 300초).
#
# 🔴 비워 두면 기본 **90000**(90초)이다. 값은 **30000~100000 으로 클램프**되고 벗어나면 pm2 로그에 경고가 남는다:
#   · 상한 100000 — 러너의 이 호출 curl 상한(110초)보다 길면 러너가 먼저 포기하고 서버는 계속 돌아
#     다음 틱이 `already_running` 으로 거절되고 **창이 진행을 멈춘다**(마감만 늘려도 그 달이 미완이 된다).
#   · 하한 30000 — 더 짧으면 한 호출이 한두 종목만 처리해 **창 안에 그날 수집이 끝나지 않는다**.
# 바꾼 뒤 `pm2 restart stockinvest --update-env`(재빌드 불필요).
KIS_FUND_BUDGET_MS=

# T-156: analysis + shadow drafts only. Set a common, reviewed US session epoch
# before publishing live-qualified M40 snapshots. Empty epoch fails closed.
T156_M40_EPOCH_SESSION=
T156_M40_AGENT_ENABLED=false
T156_M40_AGENT_POLICY_VERSION=

# Optional read-only evaluation feed for the reviewed NYS:BRK.B coherent pair only.
# Absolute path to operator-owned mode-0600 APCA_API_KEY_ID/APCA_API_SECRET_KEY file.
# Required when the frozen cohort/holdings requires NYS:BRK.B; missing profile fails closed.
# Other symbols retain their existing provider. Never put credential values here.
M40_BRK_ALPACA_KEY_FILE=
# Defaults to ~/.stockinvest-market-data/NYSMST-20261101.COD; exact approved SHA required.
M40_BRK_KIS_MASTER_FILE=
