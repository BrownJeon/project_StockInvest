# Server
PORT=3003
NODE_ENV=development

# NAS MariaDB
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PWD=
DB_NAME=stockinvest

# ─── 한국투자증권 KIS OpenAPI ─────────────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=        # 계좌번호 (숫자 8자리)
KIS_ACCOUNT_PRODUCT=01 # 상품코드 (주식현물=01)
KIS_MOCK=true          # true=모의투자, false=실전투자

# ─── 안전장치 ────────────────────────────────────────────────────────────────
DRY_RUN=true                      # true면 실제 거래소 API 호출 없이 로그만 기록
KILL_SWITCH=false                 # true면 모든 주문 즉시 차단
# legacy 시장 무관 한도 (시장별 변수 미설정 시 폴백)
ORDER_MAX_KRW=100000              # 1회 주문 최대 KRW
DAILY_ORDER_MAX_KRW=500000        # 1일 누적 주문 최대 KRW

# ─── 시장별 안전장치 ─────────────────────────────────────────────────────────
# 국내주식
ORDER_MAX_DOMESTIC_KRW=100000
DAILY_ORDER_MAX_DOMESTIC_KRW=500000
# 해외주식 (KRW 환산 한도 — 주문 시 USD→KRW 환산 후 비교)
ORDER_MAX_OVERSEAS_KRW=50000
DAILY_ORDER_MAX_OVERSEAS_KRW=300000

# ─── 블랙리스트 (거래정지·관리종목 등) ───────────────────────────────────────
# 정책: 화이트리스트 폐기. universe + 보유 심볼만 평가하되, 명시적 차단할 종목만 등록.
# 비워두면 차단 없음. settings UI에서 직접 등록·삭제 가능.
BLOCKED_SYMBOLS_DOMESTIC=
BLOCKED_SYMBOLS_OVERSEAS=

# ─── 해외주식 (KIS overseas) ─────────────────────────────────────────────────
KIS_OVERSEAS_ENABLED=true              # false면 해외 어댑터·잔고 조회 비활성
KIS_OVERSEAS_DEFAULT_EXCHANGE=NAS      # NAS|NYS|AMS — 기본 거래소

# ─── 환율 (USD/KRW) ──────────────────────────────────────────────────────────
# 외부 API 폴백 실패 시 사용할 정적 환율 (대략적인 시세, 운영자가 주기적 업데이트)
FX_USDKRW_FALLBACK=1380

# ─── 매매 전략 프로파일 ────────────────────────────────────────────────────────
DEFAULT_TRADING_STYLE=swing       # scalp | day | swing | position | dca
ASSET_PROFILE_CRYPTO_SKIP_VERIFY=auto
ASSET_PROFILE_STOCK_SKIP_VERIFY=false

# ─── 시그널 / 분석가 ──────────────────────────────────────────────────────────
SIGNAL_AUTO_SUBMIT_MAX_KRW=50000
SIGNAL_DEFAULT_TTL_MIN=30
ANALYST_ENABLED=false

# ─── AI 필터 (Anthropic Claude SDK) ──────────────────────────────────────────
# analyst 기반 시그널을 Claude로 2차 필터링. 미설정 시 AI 필터 스킵.
ANTHROPIC_API_KEY=

# ─── 변동폭 가드 ────────────────────────────────────────────────────────────
VOL_GUARD_ENABLED=false
VOL_GUARD_WINDOW_MIN=60
VOL_GUARD_WARN_PCT=-2
VOL_GUARD_BLOCK_PCT=-4
VOL_GUARD_PANIC_PCT=-7

# ─── Universe (동적 종목 선별) ─────────────────────────────────────────────────
UNIVERSE_ENABLED=true

# ─── 크론 보안 ─────────────────────────────────────────────────────────────────
CRON_SECRET=

# ─── Slack 알람 ───────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=

# ─── Telegram 알람 ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── LLM Provider (AI 분석가 호출 백엔드) ───────────────────────────────────
# DB system_config.llm_provider 가 있으면 그 값을 우선 사용 (UI에서 런타임 변경 가능)
LLM_PROVIDER=claude               # claude | ollama | home-m4-api (기본 claude)

# Ollama 사용 시 — 다른 서버에 호스팅된 Ollama HTTP API 연동
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.3

# home-m4-api 사용 시 — 자체 운영 LLM 허브 (POST /v1/chat, X-API-Key 헤더)
# .env 값은 초기값. UI(/settings)에서 변경 시 DB(system_config)에 저장되며 DB가 우선.
# AI_API_KEY 는 보안상 .env 전용 — UI에서 표시·수정 불가.
AI_API_BASE=http://192.168.0.10:8000
AI_API_MODEL=llama3
AI_API_TEMPERATURE=0.3
AI_API_KEY=mk_your_key_here
